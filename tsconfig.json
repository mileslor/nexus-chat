{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "outDir": ".webpack",
    "baseUrl": ".",
    "paths": {
      "@core/*": ["src/core/*"],
      "@platforms/*": ["platforms/*"],
      "@renderer/*": ["src/renderer/*"]
    }
  },
  "include": ["src/**/*", "platforms/**/*"],
  "exclude": ["node_modules"]
}
